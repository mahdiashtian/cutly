# ---- Telegram ----
API_ID=123456
API_HASH=replace_me
BOT_TOKEN=replace_me
# The owner: always an admin, cannot be removed from the bot.
ADMIN_MASTER=123456789
# Private channel (bot is admin) that keeps a copy of every upload.
STORAGE_CHANNEL_ID=-1001234567890
SESSION_NAME=cutly
SESSION_STRING=
CREATOR_USERNAME=

# ---- Database (the postgres service in docker-compose.yml) ----
DB_URL=postgresql+asyncpg://cutly:cutly@127.0.0.1:25432/cutly
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
DB_COMMAND_TIMEOUT=60

# ---- Redis (the redis-cache / redis-state services in docker-compose.yml) ----
REDIS_CACHE_URL=redis://127.0.0.1:26379/0
REDIS_STATE_URL=redis://127.0.0.1:26380/0
REDIS_MAX_CONNECTIONS=64
# Empty: the Celery queue lives on REDIS_STATE_URL.
CELERY_BROKER_URL=

# ---- Background workers ----
# python main.py also starts the Celery worker and beat; set false to run them yourself.
EMBEDDED_WORKERS=true
WORKER_CONCURRENCY=4

# ---- Lifetimes (seconds) ----
CACHE_TTL_SECONDS=86400
FORCED_JOIN_CACHE_SECONDS=60
CONVERSATION_TTL_SECONDS=86400
ACTIVITY_TOUCH_SECONDS=300

# ---- Features ----
DELETE_AFTER_SECONDS=30
UPLOAD_MAX_FILES=100
BROADCAST_RATE_PER_SECOND=15
BROADCAST_PAGE_SIZE=200
TIMEZONE=Asia/Tehran
LOG_LEVEL=INFO

# ---- Backups ----
BACKUP_DIR=backup
RESTORE_MAX_BYTES=2147483648
PG_DUMP_PATH=
PG_TOOL_TIMEOUT=900
