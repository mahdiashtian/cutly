API_ID=123456
API_HASH=replace_me
BOT_TOKEN=replace_me
ADMIN_MASTER=123456789
STORAGE_CHANNEL_ID=-1001234567890
SESSION_NAME=cutly
SESSION_STRING=
WORKERS=20
# Existing sqlite://db.sqlite3 and postgres://... values are accepted.
DB_URL=sqlite+aiosqlite:///db.sqlite3
# DB_NAME, DB_USER, DB_PASSWORD, DB_HOST, DB_PORT work if DB_URL is empty.
REDIS_ENABLED=true
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
# Logical backups and restore upload limits.
BACKUP_DIR=backup
RESTORE_MAX_BYTES=2147483648
PG_TOOL_TIMEOUT=900
# Empty values select the newest installed PostgreSQL client.
PG_DUMP_PATH=
PG_RESTORE_PATH=
