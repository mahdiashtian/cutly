# ---- Telegram ----
API_ID=123456
API_HASH=replace_me
BOT_TOKEN=replace_me
# The owner: always an admin, cannot be removed from the bot.
ADMIN_MASTER=123456789
# Private channel (bot is admin) that keeps a copy of every upload.
STORAGE_CHANNEL_ID=-1001234567890
SESSION_NAME=cutly
SESSION_STRING=
CREATOR_USERNAME=

# ---- Database ----
# PostgreSQL in production; legacy postgres:// and sqlite:// URLs are accepted.
DB_URL=postgresql+asyncpg://cutly:secret@localhost:5432/cutly
# Or, when DB_URL is empty: DB_NAME / DB_USER / DB_PASSWORD / DB_HOST / DB_PORT
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
DB_COMMAND_TIMEOUT=60

# ---- Redis ----
# One instance works; for production split the disposable cache (LRU) from the
# state instance (conversations, uploads, Celery queue: persistence, noeviction).
REDIS_URL=redis://localhost:6379/0
REDIS_CACHE_URL=
REDIS_STATE_URL=
REDIS_MAX_CONNECTIONS=64
# Defaults to REDIS_STATE_URL.
CELERY_BROKER_URL=

# ---- Lifetimes (seconds) ----
CACHE_TTL_SECONDS=86400
FORCED_JOIN_CACHE_SECONDS=60
CONVERSATION_TTL_SECONDS=86400
ACTIVITY_TOUCH_SECONDS=300

# ---- Features ----
DELETE_AFTER_SECONDS=30
UPLOAD_MAX_FILES=100
BROADCAST_RATE_PER_SECOND=15
BROADCAST_PAGE_SIZE=200
TIMEZONE=Asia/Tehran
LOG_LEVEL=INFO

# ---- Backups ----
BACKUP_DIR=backup
RESTORE_MAX_BYTES=2147483648
PG_DUMP_PATH=
PG_TOOL_TIMEOUT=900
